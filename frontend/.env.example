# Smart Food Tour App - Environment Variables

# API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Application Settings
NEXT_PUBLIC_APP_NAME=Smart Food Tour
NEXT_PUBLIC_APP_VERSION=0.1.0

# Map Settings (for future integration with real maps)
NEXT_PUBLIC_MAP_API_KEY=your_map_api_key_here
NEXT_PUBLIC_VINH_KHANH_LAT=10.796
NEXT_PUBLIC_VINH_KHANH_LNG=106.749

# Chatbot Settings
NEXT_PUBLIC_CHATBOT_URL=http://localhost:8000
NEXT_PUBLIC_CHATBOT_API_KEY=your_chatbot_api_key

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id
