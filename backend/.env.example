APP_NAME=GPS Visitor Experience Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

DATABASE_URL=mysql+pymysql://gps_user:gps_password@127.0.0.1:3306/gps_visitor_app?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

MONITOR_ACTIVE_WINDOW_MINUTES=5
